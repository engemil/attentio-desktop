# ==============================================================================
# Flutter, Dart & Pub
# ==============================================================================
.dart_tool/
.packages
/build/

# Directory created by dartdoc
**/doc/api/

# Flutter plugin dependencies
.flutter-plugins
.flutter-plugins-dependencies

# Flutter package cache
.pub-cache/
.pub/

# Platform-specific ephemeral build files
# (each platform subdirectory also has its own .gitignore covering this)
**/ios/Flutter/.last_build_id
/macos/Flutter/ephemeral/
/windows/flutter/ephemeral/
/linux/flutter/ephemeral/

# Android build artifacts and configurations
/android/app/debug
/android/app/profile
/android/app/release

# Symbolication & Obfuscation related
app.*.symbols
app.*.map.json

# Web generated files
*.dart.js
*.info.json
*.js.deps
*.js.map

# Test coverage output
coverage/

# ==============================================================================
# Rust & Cargo
# ==============================================================================
# Ignore the target directory from Cargo builds, regardless of where it is
**/target/

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants (mutation testing data)
**/mutants.out*/

# ==============================================================================
# flutter_rust_bridge (FRB) Generated Files
# ==============================================================================
# Since we have flutter_rust_bridge_codegen installed in our Devcontainer,
# we can safely ignore the generated Dart/Rust bridge files to keep the first
# commit and future Pull Requests completely clean.
# To regenerate these files on a fresh clone, simply run:
#   flutter_rust_bridge_codegen generate

lib/src/rust/
rust/src/frb_generated.rs
rust/src/frb_generated.io.rs
rust/src/frb_generated.web.rs
**/frb_generated.h

# ==============================================================================
# Miscellaneous & Environment
# ==============================================================================
# Environment variables
.env*

# General environment / IDE
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history/
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code related
# (We keep the .devcontainer folder, but ignore personal .vscode settings if desired)
# .vscode/
